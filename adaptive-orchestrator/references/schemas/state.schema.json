{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task",
    "status",
    "attempt",
    "updated_at"
  ],
  "properties": {
    "task": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PLANNED",
        "READY",
        "CLAIMED",
        "IN_PROGRESS",
        "IN_REVIEW",
        "REVISION_REQUIRED",
        "BLOCKED",
        "WAITING_FOR_HUMAN",
        "WAITING_FOR_EXTERNAL",
        "DONE",
        "CANCELLED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string"
    }
  }
}
