{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "runtime_id",
    "harness",
    "capabilities",
    "tools",
    "models",
    "model_policy",
    "autonomy",
    "multi_harness"
  ],
  "properties": {
    "runtime_id": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": {"anyOf": [{"type": "boolean"}, {"const": "unknown"}]}
    },
    "tools": {"type": "array", "items": {"type": "string"}},
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_models", "profiles", "role_defaults"],
      "properties": {
        "allowed_models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "roles", "quality_tier", "relative_cost", "capabilities", "family", "research"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["fast_worker", "coder", "reasoner", "critic", "escalation"]}
              },
              "quality_tier": {"enum": ["basic", "standard", "advanced"]},
              "relative_cost": {"enum": ["low", "medium", "high", "unknown"]},
              "capabilities": {
                "type": "object",
                "additionalProperties": {"anyOf": [{"type": "boolean"}, {"const": "unknown"}]}
              },
              "family": {"type": "string", "minLength": 1},
              "research": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "confidence", "sources"],
                "properties": {
                  "status": {"enum": ["verified", "unknown"]},
                  "confidence": {"enum": ["low", "medium", "high"]},
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["url", "retrieved_at", "summary"],
                      "properties": {
                        "url": {"type": "string", "minLength": 1},
                        "retrieved_at": {"type": "string", "format": "date-time"},
                        "summary": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                },
                "allOf": [{
                  "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
                  "then": {"properties": {"sources": {"minItems": 1}}}
                }]
              }
            }
          }
        },
        "role_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fast_worker", "coder", "reasoner", "critic", "escalation"],
          "properties": {
            "fast_worker": {"type": "string", "minLength": 1},
            "coder": {"type": "string", "minLength": 1},
            "reasoner": {"type": "string", "minLength": 1},
            "critic": {"type": "string", "minLength": 1},
            "escalation": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["autopilot", "ask"]},
        "level": {"enum": ["CEO", "manager", "full_control"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "ask"}}, "required": ["mode"]},
          "then": {"required": ["level"]}
        }
      ]
    },
    "multi_harness": {
      "type": "object",
      "required": ["enabled", "harnesses"],
      "properties": {
        "enabled": {"type": "boolean"},
        "harnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["runtime_id", "purpose"],
            "properties": {
              "runtime_id": {"type": "string"},
              "purpose": {"type": "string"},
              "capabilities": {"type": "object"},
              "tools": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
