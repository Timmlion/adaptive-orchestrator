{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "department",
    "objective",
    "dependencies",
    "requirements",
    "acceptance_criteria",
    "review_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object"
    },
    "requirements": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "properties": {
        "preferred_runtime": {
          "type": "string",
          "description": "Optional scheduling preference; never a hard eligibility requirement."
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "verification"
        ]
      }
    },
    "review_policy": {
      "type": "object"
    }
  }
}
